MCP_HOST=127.0.0.1
MCP_PORT=8010
# Secret path: python -c "import secrets; print('/mcp/' + secrets.token_urlsafe(24))"
MCP_PATH=/mcp/REPLACE_WITH_RANDOM_SECRET
DB_PATH=/opt/meallog/data/meals.db
TZ_NAME=Europe/Moscow
# PWA login
APP_PASSWORD=REPLACE_ME
# Session cookie value: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_COOKIE=REPLACE_WITH_RANDOM_SECRET
# Optional: daily plan generation
ANTHROPIC_API_KEY=
PLAN_MODEL=claude-opus-5-5
